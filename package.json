{
  "name": "shieldpay-zk",
  "version": "0.1.0",
  "private": true,
  "description": "ShieldPay ZK monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run -ws build",
    "test": "npm run -ws test",
    "lint": "npm run -ws lint",
    "test:localnet": "vitest run tests/localnet-runtime.test.ts",
    "dev:merchant-api": "npm run --workspace @shieldpay/merchant-api dev",
    "dev:demo-web": "npm run --workspace @shieldpay/demo-web dev",
    "dev:mock-sas-service": "npm run --workspace @shieldpay/mock-sas-service dev"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@solana/web3.js": "^1.98.4",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
