# Copy to `.env` for local overrides (never commit `.env`).
# Merchant API
# MERCHANT_API_PORT=3000
# VERIFICATION_MODE=mock
# With VERIFICATION_MODE=sas, merchant-api defaults to the demo-web SAS proxy (merges “negative wallet” demo).
# To talk to mock-sas only: SAS_ATTESTATION_ENDPOINT=http://127.0.0.1:3100/sas/attestations/latest
# VERIFIER_PRIVATE_KEY_HEX=
# SHIELDPAY_ISSUER_PRIVATE_KEY_HEX=
# SHIELDPAY_ISSUER_KEY_ID=shieldpay_issuer_v1
# SOLANA_CLUSTER=localnet
# SOLANA_RPC_URL=

# Demo web
# DEMO_WEB_PORT=4173
# MERCHANT_API_BASE_URL=http://127.0.0.1:3000

# Mock SAS (required for SAS mode; demo-web proxies to it unless you override SAS_ATTESTATION_ENDPOINT)
# MOCK_SAS_PORT=3100
# MOCK_SAS_BASE_URL=http://127.0.0.1:3100
